# Base de datos
DATABASE_PATH=./prestamax.db

# JWT
JWT_SECRET=GENERAR_UN_SECRET_SEGURO_AQUI_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=development

# Frontend URL (CORS / CSP)
FRONTEND_URL=http://localhost:5173

# Stripe (desconectado — no en uso actualmente, ver Whop abajo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_BASICO=price_...
STRIPE_PRICE_PROFESIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Whop (pasarela de pago activa)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=whsec_...
WHOP_PLAN_STARTER=plan_...
WHOP_PLAN_BASICO=plan_...
WHOP_PLAN_PROFESIONAL=plan_...
WHOP_PLAN_ENTERPRISE=plan_...

# Email (Resend) — notificaciones de leads al admin y recordatorios de trial
# a tenants. Sin RESEND_API_KEY el sistema sigue funcionando normal, solo no
# se envia ningun email (ver backend/src/services/emailService.ts).
RESEND_API_KEY=re_...
ADMIN_EMAIL=tu-correo@ejemplo.com
FROM_EMAIL=CredyTek <onboarding@resend.dev>
ADMIN_WHATSAPP=18095551234
